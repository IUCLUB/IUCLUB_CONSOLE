# Domain gốc. Chạy thử trên máy: localhost (trình duyệt tự hiểu *.localhost)
DOMAIN=localhost
HTTP_PORT=8088
CONSOLE_URL=http://admin.localhost:8088
PROJECT_URL=http://{slug}.localhost:8088
# Chuỗi ngẫu nhiên >= 24 ký tự để ký phiên đăng nhập: openssl rand -hex 32
SECRET=
# Chuỗi ngẫu nhiên khác (>= 24 ký tự), chỉ gateway và Console biết: openssl rand -hex 32
GATE_SECRET=
# Quản trị viên đầu tiên: email:matkhau (cách nhau dấu chấm phẩy). Chỉ dùng khi tài khoản chưa tồn tại;
# sau đó quản lý tài khoản trên Console → Thành viên.
CONSOLE_USERS=
# Cứu tài khoản: email:matkhaumoi → khởi động lại console, rồi XOÁ dòng này
# CONSOLE_RESET=
# Chỉ trên server: bật service sao lưu lên Google Drive (xem README → Sao lưu)
# COMPOSE_PROFILES=backup
# BACKUP_REMOTE_DIR=iu-club-backups
